{
  "name": "@ahtapot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "tsc -b && node --test \"dist/**/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "dev:build": "tsc -b --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@ahtapot/shared": "*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^13.0.0",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.0"
  }
}
